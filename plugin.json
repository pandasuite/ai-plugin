{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "pandasuite",
  "version": "0.3.1",
  "description": "Explore and understand PandaSuite Studio projects — screens, units, structure, and state (read-only).",
  "author": {
    "name": "PandaSuite",
    "url": "https://pandasuite.com"
  },
  "homepage": "https://pandasuite.com",
  "repository": "https://github.com/pandasuite/ai-plugin",
  "license": "MIT",
  "keywords": [
    "pandasuite",
    "no-code",
    "studio",
    "app-builder",
    "interactive"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "PandaSuite",
        "shortDescription": "Explore PandaSuite Studio projects",
        "longDescription": "Connect an AI agent to your PandaSuite Studio project: list screens, inspect units and containers, understand structure and state — read-only.",
        "developerName": "PandaSuite",
        "category": "Productivity",
        "capabilities": [
          "Read"
        ],
        "websiteURL": "https://pandasuite.com",
        "privacyPolicyURL": "https://www.iubenda.com/privacy-policy/47093119",
        "termsOfServiceURL": "https://www.iubenda.com/terms-and-conditions/47093119",
        "defaultPrompt": [
          "List the screens in my PandaSuite project",
          "Describe the structure of this screen",
          "What units are on the home screen?"
        ],
        "brandColor": "#1ED3A3",
        "logo": "./assets/logo.svg"
      }
    }
  }
}
